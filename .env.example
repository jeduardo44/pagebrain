# ─────────────────────────────────────────────────────────────────────
# PageBrain — configuração. Copia para `.env` e preenche.
#   cp .env.example .env
# O `.env` está no .gitignore (nunca vai para o GitHub).
# ─────────────────────────────────────────────────────────────────────

# ── OBRIGATÓRIA para o chat funcionar ────────────────────────────────
# Como obter:
#   1. Cria conta em https://console.anthropic.com/
#   2. Settings → API Keys → Create Key
#   3. Copia a chave (sk-ant-...) para aqui.
# Sem esta chave o projeto arranca em "modo básico" (mostra o conteúdo
# da página, mas o chat não responde).
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Modelo Claude a usar. Por omissão claude-opus-5 (potente, mas caro:
# $5/$25 por milhão de tokens). Para um chat de páginas, alternativas
# mais baratas: claude-sonnet-5 ($2/$10) ou claude-haiku-4-5 ($1/$5).
CLAUDE_MODEL=claude-opus-5

# ── OPCIONAIS — enriquecimento externo (o resto funciona sem elas) ───
# Brave Search API (notícias/reviews): https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Clearbit (dados de empresa): https://clearbit.com/  (Enrichment API)
CLEARBIT_API_KEY=

# ── Defaults (podes deixar como estão) ───────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
CACHE_TTL_HOURS=24
MAX_SCRAPE_PAGES=8
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu          # cpu evita competir por memória de GPU (Mac 8GB)
REQUEST_TIMEOUT=15
LOG_LEVEL=INFO
# Origens permitidas para CORS (a extensão chama o backend a partir de chrome-extension://)
ALLOWED_ORIGINS=*
